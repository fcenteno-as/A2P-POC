{
  "name": "A2P 10DLC Console",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "A2P Console",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },
  "postStartCommand": "nohup python3 -m http.server 8080 --bind 0.0.0.0 > /tmp/server.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
