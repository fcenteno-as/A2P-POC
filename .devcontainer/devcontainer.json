{
  "name": "A2P 10DLC Console",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "A2P Console",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },
  "postStartCommand": "nohup npx --yes serve . -p 8080 -c serve.json > /tmp/server.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
